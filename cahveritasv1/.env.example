# CAH VERITAS (cah-veritas2) — settings. In a Databricks App set these in
# app.yaml `env:`; locally copy to .env. Defaults keep everything on DuckDB.

# ---- LLM ----
# databricks: Claude through Databricks Model Serving — the model names below are
#             serving-endpoint names; auth is your Databricks credentials.
# anthropic:  the Anthropic API directly — the model names are Anthropic model ids.
VERITAS_LLM_PROVIDER=databricks
VERITAS_MODEL_FAST=
VERITAS_MODEL_SMART=
VERITAS_MODEL_VISION=
VERITAS_VISION=1
VERITAS_CONCURRENCY=6
# anthropic provider only
ANTHROPIC_API_KEY=

# ---- Runtime: local | databricks ----
VERITAS_RUNTIME=local

# ---- App state: DuckDB, always ----
VERITAS_DB_PATH=data/veritas.duckdb
VERITAS_KB_DIR=kb
# Optional: restore/back up the DuckDB file to a Volume folder (Databricks App disk is ephemeral)
VERITAS_STATE_BACKUP_VOLUME=

# ---- Analytics store for the UAT SQL: duckdb | databricks ----
VERITAS_SQL_BACKEND=duckdb
# duckdb only: create the synthetic demo mart at start-up when missing
VERITAS_SEED_DEMO_MART=0
# databricks only:
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_CATALOG=
# one schema, or several comma-separated
DATABRICKS_SCHEMA=

# ---- Inputs: local folder (default) or a Unity Catalog Volume ----
VERITAS_INPUTS_DIR=inputs
# /Volumes/<catalog>/<schema>/<volume>/<folder> holding brd/ design/ sources/ code/ uat_baseline/
VERITAS_INPUTS_VOLUME=
# where the Volume is mirrored when it is not mounted (Databricks Apps)
VERITAS_INPUTS_CACHE=data/volume_inputs
VERITAS_INPUTS_SYNC_ON_START=1

# ---- Databricks auth outside a Databricks App (inside one it is injected) ----
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# ---- Optional ----
# one serving endpoint for every LLM tier left unset above
DATABRICKS_SERVING_ENDPOINT=
VERITAS_VECTOR_SEARCH=0
DATABRICKS_VS_ENDPOINT=
DATABRICKS_VS_INDEX=
